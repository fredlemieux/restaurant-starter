PUBLIC_SITE_URL=http://localhost:4321

# Sanity
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-01-01
SANITY_READ_TOKEN=

# Offline mode — bypass Sanity, use local fixtures from src/fixtures/.
# Useful on planes, for demos without a Sanity project, and in e2e tests.
# Any value other than '1' or 'true' means online.
SANITY_OFFLINE=

# Resend (contact form email)
RESEND_API_KEY=
CONTACT_TO_ADDRESS=hello@example.com
CONTACT_FROM_ADDRESS=no-reply@example.com

# Cloudflare Turnstile (anti-spam on contact form)
# Cloudflare test keys — no CF account required. Swap for real keys before deploying.
# Sitekeys control what the widget does; secret keys control what siteverify returns.
# They're INDEPENDENT — the interactive-challenge sitekey needs the always-passes
# secret, otherwise the widget goes green then the server rejects the token.
#   Sitekeys:  1x…AA = always passes (silent) · 2x…AB = always fails
#              3x…FF = forces interactive challenge (visible widget)
#   Secrets:   1x…AA = always passes · 2x…AA = always fails
#              3x…AA = ALWAYS returns "token already spent" — don't use as pair
# See https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=3x00000000000000000000FF
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

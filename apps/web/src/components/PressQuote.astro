---
/**
 * Shared press-quote presentation. Two variants:
 *   - default (compact) — homepage 3-column grid, no meta
 *   - detail — press page 2-column grid with published date + article link,
 *              hairline separator above for row rhythm
 *
 * Extracted from duplicated markup that lived in both index.astro and
 * press.astro. Third usage (e.g. future "featured press" module) can drop
 * in without further duplication.
 */
import type { PressMention } from '@restaurant/schemas';

interface Props {
  item: PressMention;
  detail?: boolean;
}

const { item, detail = false } = Astro.props;

const publishedLabel = item.publishedOn
  ? new Date(item.publishedOn).toLocaleDateString('en-GB', {
      month: 'long',
      year: 'numeric',
    })
  : null;
---

<article class:list={['text-center', detail ? 'border-ink/10 border-t pt-12' : 'px-4']}>
  <p
    class:list={[
      'font-display font-light italic leading-snug',
      detail ? 'text-3xl md:text-4xl' : 'text-2xl md:text-3xl',
    ]}
  >
    &ldquo;{item.quote}&rdquo;
  </p>
  <p class="text-ink/60 mt-6 text-xs uppercase tracking-[0.25em]">
    {item.publication}{item.author ? ` · ${item.author}` : ''}
  </p>
  {detail && publishedLabel && <p class="text-ink/40 mt-1 text-xs">{publishedLabel}</p>}
  {
    detail && item.url && (
      <a
        href={item.url}
        target="_blank"
        rel="noreferrer noopener"
        class="hover:text-clay mt-6 inline-block border-b border-current pb-1 text-xs uppercase tracking-[0.25em]"
      >
        Read article
      </a>
    )
  }
</article>

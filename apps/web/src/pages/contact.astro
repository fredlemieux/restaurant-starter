---
import Base from '@/layouts/Base.astro';
import { ContactForm, OpenTableEmbed } from '@restaurant/ui';
import { getRestaurant } from '@/lib/queries';

const restaurant = await getRestaurant();
// Normalise empty-string env var to `undefined` so server + client render
// the same markup (an empty prop that only exists during hydration breaks
// React's checksum with "Expected server HTML to contain a matching…").
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || undefined;
---

<Base title="Contact" description="Get in touch">
  <section class="mx-auto max-w-3xl px-6 pb-16 pt-32 text-center">
    <p class="text-clay mb-5 text-xs uppercase tracking-[0.35em]">Get in touch</p>
    <h1 class="font-display text-6xl font-light leading-[0.95] md:text-7xl">Contact.</h1>
  </section>
  <div class="mx-auto grid max-w-5xl gap-16 px-6 pb-32 md:grid-cols-2">
    <div>
      <h2 class="font-display mb-6 text-3xl font-light">Come and find us</h2>
      {
        restaurant?.phone && (
          <p>
            Phone:{' '}
            <a href={`tel:${restaurant.phone}`} class="underline">
              {restaurant.phone}
            </a>
          </p>
        )
      }
      {
        restaurant?.email && (
          <p>
            Email:{' '}
            <a href={`mailto:${restaurant.email}`} class="underline">
              {restaurant.email}
            </a>
          </p>
        )
      }
      {
        restaurant?.address && (
          <address class="mt-4 text-sm not-italic">
            {restaurant.address.line1}
            <br />
            {restaurant.address.city} {restaurant.address.postcode}
          </address>
        )
      }
      <h2 class="mb-3 mt-10 text-2xl">Reservations</h2>
      {
        restaurant?.openTableRid ? (
          <OpenTableEmbed client:visible rid={restaurant.openTableRid} />
        ) : (
          <p class="text-ink/70 text-sm">Use the form below or phone to book.</p>
        )
      }
    </div>
    <div>
      <h2 class="mb-4 text-2xl">Send us a message</h2>
      <ContactForm client:load action="/api/contact" turnstileSiteKey={turnstileKey} />
    </div>
  </div>
  {
    turnstileKey && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
    )
  }
</Base>

---
import Base from '@/layouts/Base.astro';
import { MenuList } from '@restaurant/ui';
import { getMenus } from '@/lib/queries';
import type { Menu } from '@restaurant/schemas';

export async function getStaticPaths() {
  const menus = await getMenus();
  return menus.map((menu) => ({
    params: { slug: menu.slug.current },
    props: { menu },
  }));
}

interface Props {
  menu: Menu;
}
const { menu } = Astro.props;
---

<Base title={`${menu.title} — Menu`} description={menu.available}>
  <MenuList menu={menu} />
</Base>

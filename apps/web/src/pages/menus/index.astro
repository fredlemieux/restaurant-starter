---
import Base from '@/layouts/Base.astro';
import { getMenus } from '@/lib/queries';

const menus = await getMenus();
---

<Base title="Menus" description="Our menus">
  <div class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="mb-8 text-5xl">Menus</h1>
    <ul class="space-y-4">
      {
        menus.map((m) => (
          <li>
            <a
              href={`/menus/${m.slug.current}`}
              class="border-ink/10 hover:bg-ink/5 -mx-4 block rounded border-b px-4 py-3"
            >
              <span class="text-2xl">{m.title}</span>
              {m.available && <span class="text-ink/70 block text-sm">{m.available}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

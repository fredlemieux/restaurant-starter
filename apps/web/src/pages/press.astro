---
import Base from '@/layouts/Base.astro';
import PressQuote from '@/components/PressQuote.astro';
import { getPress } from '@/lib/queries';

const press = await getPress();
---

<Base title="Press" description="In the press">
  <section class="mx-auto max-w-3xl px-6 pb-16 pt-32 text-center">
    <p class="text-clay mb-5 text-xs uppercase tracking-[0.35em]">Reviews</p>
    <h1 class="font-display text-6xl font-light leading-[0.95] md:text-7xl">In the papers.</h1>
  </section>
  <section class="mx-auto max-w-5xl px-6 pb-32">
    <ul class="grid gap-16 md:grid-cols-2">
      {
        press.map((p) => (
          <li>
            <PressQuote item={p} detail />
          </li>
        ))
      }
    </ul>
  </section>
</Base>

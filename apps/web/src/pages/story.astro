---
import Base from '@/layouts/Base.astro';
import PortableTextBlock from '@/components/PortableTextBlock.astro';
import { getRestaurant } from '@/lib/queries';

const restaurant = await getRestaurant();
---

<Base title="Our story" description={restaurant?.tagline}>
  <section class="mx-auto max-w-3xl px-6 pb-16 pt-32 text-center">
    <p class="text-clay mb-5 text-xs uppercase tracking-[0.35em]">The house</p>
    <h1 class="font-display mb-8 text-6xl font-light leading-[0.95] md:text-7xl">Our story.</h1>
    {
      restaurant?.tagline && (
        <p class="text-ink/70 mx-auto max-w-xl text-lg font-light">{restaurant.tagline}</p>
      )
    }
  </section>
  <article
    class="text-ink/85 first-letter:font-display mx-auto max-w-2xl space-y-6 px-6 pb-32 text-lg font-light leading-relaxed first-letter:float-left first-letter:mr-3 first-letter:text-6xl first-letter:leading-none"
  >
    <PortableTextBlock blocks={restaurant?.about} />
  </article>
</Base>
